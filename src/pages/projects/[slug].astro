---
import Base from '../../layouts/Base.astro';
import projects from '../../data/projects.json';
export async function getStaticPaths() {
  return projects.filter((p: any) => p.featured).map((p: any) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
let g: any = {};
try { g = (await import('../../data/repos.generated.json')).default[p.slug] ?? {}; } catch {}
const order = ['reddit-story-pipeline', 'zenyth-ide', 'vencordmobile'];
const idx = order.indexOf(p.slug);
const prev = idx > 0 ? projects.find((x: any) => x.slug === order[idx - 1]) : null;
const next = idx < order.length - 1 ? projects.find((x: any) => x.slug === order[idx + 1]) : null;
const others = projects.filter((x: any) => x.slug !== p.slug && x.featured).slice(0, 2);
const category = p.slug === 'reddit-story-pipeline' ? 'Automation · video pipeline' : p.slug === 'zenyth-ide' ? 'Developer tools · desktop' : 'Mobile · native-web bridge';
---
<Base title={`${p.title} — Hugo Soares`} description={p.blurb}>
  <article class="max-w-wide mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-16">
    <p class="reveal eyebrow"><a href={`${base}projects/`} class="hover:text-[var(--color-text)]">Return to projects</a><span aria-hidden="true"> · </span>0{idx + 1} / 03 · {category}</p>
    <div class="mt-6 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-7">
        <h1 class="font-display tracking-tight text-5xl md:text-6xl">{p.title}</h1>
        <p class="mt-3 font-mono text-[12px] text-[var(--color-muted)]">{p.dates}</p>
        <p class="mt-5 body-copy text-[var(--color-muted)] max-w-text">{p.blurb}</p>
        <div class="mt-10 prose-editorial">
          <h2>What it does</h2>
          <p>{p.problem}</p>
          <h2>How it was built</h2>
          {(p.details ?? []).map((d: string) => <p>{d}</p>)}
          <h2>Stack</h2>
          <p class="font-mono text-[13px] text-[var(--color-muted)]">{p.tech.join(' · ')}</p>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 font-medium">
          <a href={`https://github.com/${p.repo}`} class="group">Open repository <span class="arrow-shift">↗</span><span class="block h-px bg-[var(--color-text)] mt-1 group-hover:bg-[var(--color-accent)] transition-colors"></span></a>
          {p.demo && <a href={p.demo} class="text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors"><span class="editorial-underline">Live demo ↗</span></a>}
        </div>
      </div>
      <aside class="lg:col-span-4 lg:col-start-9" aria-label="Project metadata">
        <dl class="hairline-t lg:sticky lg:top-24">
          {[
            ['Language', g.language ?? p.tech[0]],
            ['Stars', g.stars ? `★ ${g.stars}` : '—'],
            ['Category', category],
            ['Updated', g.pushed_at ? g.pushed_at.slice(0, 10) : 'not yet fetched'],
            ['Repository', p.repo],
          ].map(([k, v]) => (
            <div class="flex items-baseline justify-between gap-6 py-3.5 border-b border-[var(--color-hairline)]">
              <dt class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-[var(--color-faint)] shrink-0">{k}</dt>
              <dd class="font-mono text-[12.5px] text-right break-words">{v}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 font-mono text-[11px] leading-relaxed text-[var(--color-faint)]">Stars, language, and dates are fetched from GitHub at build time. A dash means the API returned nothing for that field.</p>
      </aside>
    </div>
    <nav class="mt-20 hairline-t pt-6 flex items-center justify-between gap-6" aria-label="Other projects">
      <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-faint)]">Other projects</span>
      <span class="flex gap-6 text-[15px] font-medium">
        {prev && <a href={`${base}projects/${prev.slug}/`} class="group"><span aria-hidden="true">← </span><span class="editorial-underline">{prev.title}</span></a>}
        {next && <a href={`${base}projects/${next.slug}/`} class="group"><span class="editorial-underline">{next.title}</span><span aria-hidden="true"> →</span></a>}
      </span>
    </nav>
    {others.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-[var(--color-muted)]">
        {others.filter((o: any) => o.slug !== prev?.slug && o.slug !== next?.slug).map((o: any) => (
          <a href={`${base}projects/${o.slug}/`} class="hover:text-[var(--color-text)]">· {o.title}</a>
        ))}
      </div>
    )}
  </article>
</Base>
