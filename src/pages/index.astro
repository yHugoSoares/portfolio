---
import Base from '../layouts/Base.astro';
import projects from '../data/projects.json';
let generated: Record<string, any> = {};
try { generated = (await import('../data/repos.generated.json')).default; } catch {}
const order = ['reddit-story-pipeline', 'zenyth-ide', 'vencordmobile'];
const featured = order.map((s) => projects.find((p: any) => p.slug === s)).filter(Boolean);
const base = import.meta.env.BASE_URL;
---
<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="blueprint absolute inset-0 opacity-40" aria-hidden="true"></div>
    <div class="relative max-w-wide mx-auto px-6 md:px-10 pt-12 md:pt-24 pb-14 md:pb-20 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-7">
        <p class="eyebrow">Hugo Soares — Full-Stack Software Engineer · Braga, Portugal</p>
        <h1 class="font-display tracking-tight text-[2.6rem] leading-[1.08] md:text-6xl md:leading-[1.04] mt-6">
          I design and ship<br />complete applications,<br />end to end.
        </h1>
        <p class="mt-7 max-w-text body-copy text-[var(--color-muted)]">
          Informatics Engineering graduate (University of Minho). Core languages Java and
          TypeScript, with hands-on work integrating AI services, Docker, and CI/CD
          across Desktop, Web, and Mobile.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-3 text-[15px] font-semibold">
          <a href="#work" class="group">See selected work <span class="arrow-shift">↓</span><span class="block h-px bg-[var(--color-text)] scale-x-100 group-hover:bg-[var(--color-accent)] transition-colors"></span></a>
          <a href="https://github.com/yhugosoares" class="group text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors font-medium"><span class="editorial-underline">View on GitHub ↗</span></a>
        </div>
        <p class="mt-12 hairline-t pt-5 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-muted)]">
          B.Sc. Informatics Engineering, Minho 2023–2026 · Mean grade 14/20
        </p>
      </div>
      <aside class="lg:col-span-5 lg:pt-10" aria-label="How this site builds">
        <div class="hairline-t lg:border-l lg:border-[var(--color-hairline)] lg:border-t-0 lg:pl-8 pt-6 lg:pt-0">
          <p class="eyebrow">This site — build notes</p>
          <figure class="mt-4">
            <figcaption class="font-mono text-[11px] text-[var(--color-faint)]">astro.config.mjs</figcaption>
            <pre class="mt-2 font-mono text-[12.5px] leading-[1.8] text-[var(--color-muted)] overflow-x-auto"><code>output: 'static'
site: 'https://yhugosoares.github.io'
base: '/portfolio'</code></pre>
          </figure>
          <figure class="mt-5">
            <figcaption class="font-mono text-[11px] text-[var(--color-faint)]">build command</figcaption>
            <pre class="mt-2 font-mono text-[12.5px] leading-[1.8] text-[var(--color-muted)] overflow-x-auto"><code>node scripts/fetch-repos.mjs
astro build</code></pre>
          </figure>
          <ol class="mt-6 space-y-0 font-mono text-[12px]">
            {featured.map((p: any, i: any) => (
              <li class="hairline-t py-2.5 flex items-baseline justify-between gap-4">
                <a href={`${base}projects/${p.slug}/`} class="group flex items-baseline gap-3 min-w-0">
                  <span class="text-[var(--color-faint)]">0{i + 1}</span>
                  <span class="editorial-underline text-[var(--color-text)] truncate">{p.title}</span>
                </a>
                <span class="text-[var(--color-faint)] shrink-0">{generated[p.slug]?.language ?? p.tech[0]}</span>
              </li>
            ))}
            <li class="hairline-t border-b border-[var(--color-hairline)] py-2.5 flex justify-between text-[var(--color-faint)]"><span>Full list in archive</span><a href={`${base}projects/`} class="hover:text-[var(--color-text)]">Browse the archive →</a></li>
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="max-w-wide mx-auto px-6 md:px-10 py-20 md:py-28 hairline-t grid md:grid-cols-12 gap-8 scroll-mt-20">
    <div class="md:col-span-3"><p class="reveal eyebrow">01 / About</p></div>
    <div class="md:col-span-9 lg:col-span-7">
      <p class="font-display text-2xl md:text-[2rem] leading-[1.35] tracking-tight">
        I build complete applications and deliver them independently, from first commit to running release.
      </p>
      <p class="mt-6 max-w-text body-copy text-[var(--color-muted)]">
        I'm Hugo Soares, based in Braga, Portugal. I graduated in Informatics Engineering
        from the University of Minho (2023–2026). I work across Desktop, Web, and Mobile,
        and I test my software the way I was taught: JUnit, property-based tests, and
        staged rollouts before anything reaches users.
      </p>
      <div class="mt-10">
        <p class="eyebrow">Languages</p>
        <p class="mt-3 font-mono text-[13px] leading-relaxed text-[var(--color-muted)]">Portuguese (Native) · English (Fluent)</p>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section id="work" class="max-w-wide mx-auto px-6 md:px-10 py-20 md:py-28 hairline-t scroll-mt-20">
    <div class="grid md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-8"><p class="reveal eyebrow">02 / Selected work</p>
        <p class="mt-4 font-display text-3xl md:text-4xl tracking-tight">Three projects, delivered.</p>
      </div>
      <p class="md:col-span-4 md:text-right font-mono text-xs text-[var(--color-muted)]">Language and update dates come from GitHub at build time.</p>
    </div>
    <div class="mt-10 hairline-t">
      {featured.map((p: any, i: any) => (
        <a href={`${base}projects/${p.slug}/`} class="work-row group grid md:grid-cols-12 gap-3 md:gap-6 items-baseline py-8 md:py-10 px-2 -mx-2 md:px-4 md:-mx-4 border-b border-[var(--color-hairline)]">
          <span class="md:col-span-1 font-mono text-sm text-[var(--color-faint)] md:self-start md:pt-2">0{i + 1}</span>
          <span class="md:col-span-6">
            <span class={`work-title font-display tracking-tight block ${i === 0 ? 'text-4xl md:text-5xl' : 'text-3xl md:text-4xl'}`}>{p.title}</span>
            <span class="mt-2 block font-mono text-[11.5px] text-[var(--color-faint)]">{p.dates}</span>
            <span class="mt-3 block max-w-text leading-relaxed text-[var(--color-muted)]">{p.blurb}</span>
            <span class="mt-2 block text-sm text-[var(--color-muted)]">{p.problem}</span>
          </span>
          <span class="md:col-span-4 font-mono text-[11.5px] leading-loose text-[var(--color-muted)]">
            <span class="block uppercase tracking-[0.14em] text-[var(--color-faint)]">{p.tech.join(' · ')}</span>
            <span class="block mt-1">{generated[p.slug]?.language ? `${generated[p.slug].language} · ` : ''}{generated[p.slug]?.pushed_at ? `updated ${generated[p.slug].pushed_at.slice(0, 7)} · ` : ''}{p.repo.replace('yHugoSoares/', '')}</span>
          </span>
          <span class="md:col-span-1 md:text-right text-xl" aria-hidden="true"><span class="arrow-shift">↗</span></span>
        </a>
      ))}
    </div>
    <p class="mt-8"><a href={`${base}projects/`} class="group font-medium">Browse the archive <span class="arrow-shift">→</span><span class="block h-px max-w-[16rem] bg-[var(--color-hairline)] mt-2 group-hover:bg-[var(--color-accent)] transition-colors"></span></a></p>
  </section>

  <!-- Skills -->
  <section id="skills" class="max-w-wide mx-auto px-6 md:px-10 py-20 md:py-28 hairline-t grid md:grid-cols-12 gap-8 scroll-mt-20">
    <div class="md:col-span-3"><p class="reveal eyebrow">03 / Capabilities</p>
      <p class="mt-4 text-sm leading-relaxed text-[var(--color-muted)] max-w-[16rem]">Taken from my CV. Every line here is used by at least one project on this site.</p>
    </div>
    <div class="md:col-span-9">
      {[
        ['Languages', 'Java · TypeScript · JavaScript · Python · Rust · C'],
        ['Frameworks', 'React · Node.js · Express · Tauri'],
        ['Databases & tools', 'PostgreSQL · Supabase · Git · Linux/Bash'],
        ['Cloud & DevOps', 'Docker · Docker Compose · GitHub Actions (CI/CD)'],
        ['AI & LLMs', 'DeepSeek API · Ollama · Local LLMs · Prompt Engineering'],
        ['Testing', 'JUnit · EvoSuite · Hypothesis · Property-Based Testing'],
      ].map(([cat, skills], i) => (
        <div class={`grid sm:grid-cols-12 gap-2 sm:gap-6 py-5 hairline-t ${i === 5 ? 'border-b border-[var(--color-hairline)]' : ''}`}>
          <h3 class="sm:col-span-4 font-medium text-[15px]">{cat}</h3>
          <p class="sm:col-span-8 text-[var(--color-muted)] leading-relaxed">{skills}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Education -->
  <section id="education" class="max-w-wide mx-auto px-6 md:px-10 py-20 md:py-28 hairline-t grid md:grid-cols-12 gap-8 scroll-mt-20">
    <div class="md:col-span-3"><p class="reveal eyebrow">04 / Education</p></div>
    <div class="md:col-span-9 lg:col-span-7">
      <h2 class="font-display text-3xl md:text-4xl tracking-tight">B.Sc. Informatics Engineering</h2>
      <p class="mt-3 font-mono text-[12px] text-[var(--color-muted)]">University of Minho · 2023 – 2026 · Mean grade 14/20</p>
      <p class="mt-6 max-w-text body-copy text-[var(--color-muted)]">Relevant coursework: Object-Oriented Programming (Java), Software Analysis and Testing (JUnit, EvoSuite), Computer Systems Security, Computer Networks, Language Processing.</p>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="max-w-wide mx-auto px-6 md:px-10 py-20 md:py-28 hairline-t grid md:grid-cols-12 gap-8 scroll-mt-20">
    <div class="md:col-span-3"><p class="reveal eyebrow">05 / Contact</p></div>
    <div class="md:col-span-9 lg:col-span-7">
      <h2 class="font-display text-3xl md:text-4xl leading-[1.15] tracking-tight">Questions about the code<br />start on GitHub.</h2>
      <p class="mt-5 max-w-text body-copy text-[var(--color-muted)]">Each repository has its own README and issue tracker. For anything else, email works.</p>
      <p class="mt-8"><a href="mailto:hugoferreirasoares@gmail.com" class="group font-display text-2xl md:text-3xl tracking-tight break-all"><span class="editorial-underline">hugoferreirasoares@gmail.com</span> <span class="arrow-shift text-xl align-middle">↗</span></a></p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-[var(--color-muted)]">
        <a href="https://github.com/yhugosoares" class="hover:text-[var(--color-text)] transition-colors">View on GitHub ↗</a>
        <a href="https://linkedin.com/in/yhugosoares" class="hover:text-[var(--color-text)] transition-colors">Open LinkedIn ↗</a>
        <span>+351 934 120 467</span>
      </div>
    </div>
  </section>
</Base>
